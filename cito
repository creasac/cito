#!/usr/bin/python3
"""A suggestion-free GNOME URL and Google search launcher."""
import ipaddress
import re
import unicodedata
from urllib.parse import quote, urlsplit


def destination(text):
    if any(unicodedata.category(c) in ('Cc', 'Cs') for c in text):
        raise ValueError('Please remove control characters.')
    text = text.strip()
    if not text:
        return None
    if re.match(r'https?://', text, re.I):
        try:
            url = urlsplit(text)
            if not url.hostname or any(c.isspace() for c in text):
                raise ValueError()
            url.port
            if '\\' in url.netloc:
                raise ValueError()
        except ValueError:
            raise ValueError('Please enter a valid HTTP or HTTPS URL.') from None
        return text
    if not any(c.isspace() for c in text) and '://' not in text:
        try:
            url = urlsplit('https://' + text)
            host = url.hostname or ''
            ascii_host = host.encode('idna').decode('ascii')
            labels = ascii_host.split('.')
            domain = (len(labels) >= 2 and
                      all(re.fullmatch(r'[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?', p) for p in labels) and
                      (re.fullmatch(r'[a-zA-Z]{2,63}', labels[-1]) or labels[-1].startswith('xn--')))
            try:
                ipaddress.ip_address(host)
                domain = True
            except ValueError:
                pass
            url.port
            if domain and not url.username and not url.password and '\\' not in text:
                return 'https://' + text
        except (ValueError, UnicodeError):
            pass
    return 'https://www.google.com/search?q=' + quote(text, safe='')


def main():
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, Gio, GLib, Gtk

    class Launcher(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='local.cito.Dialog', flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.window = None

        def do_activate(self):
            if self.window is None:
                self.window = Gtk.ApplicationWindow(application=self, title='cito')
                self.window.set_default_size(460, -1)
                self.window.set_resizable(False)
                self.window.set_position(Gtk.WindowPosition.CENTER)
                self.window.set_type_hint(Gdk.WindowTypeHint.DIALOG)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
                box.set_border_width(18)
                self.entry = Gtk.Entry()
                self.entry.set_placeholder_text('Search Google or enter a URL')
                self.entry.set_width_chars(44)
                self.entry.connect('activate', self.submit)
                box.pack_start(self.entry, False, False, 0)
                self.error = Gtk.Label()
                self.error.set_line_wrap(True)
                self.error.set_no_show_all(True)
                box.pack_start(self.error, False, False, 0)
                self.window.add(box)
                self.window.connect('key-press-event', self.key)
            self.entry.set_text('')
            self.error.hide()
            self.window.show_all()
            self.entry.grab_focus()
            self.window.present_with_time(Gtk.get_current_event_time())

        def key(self, window, event):
            if event.keyval == Gdk.KEY_Escape:
                self.quit()
                return True
            return False

        def submit(self, entry):
            try:
                uri = destination(entry.get_text())
                if uri:
                    context = self.window.get_display().get_app_launch_context()
                    context.set_timestamp(Gtk.get_current_event_time())
                    Gio.AppInfo.launch_default_for_uri(uri, context)
                self.quit()
            except (ValueError, GLib.Error) as exc:
                self.error.set_text(str(exc))
                self.error.show()

    Launcher().run(None)


if __name__ == '__main__':
    main()
